#include "dinorunner.h"

static const unsigned char kVersionMajor = @PROJECT_VERSION_MAJOR@;
static const unsigned char kVersionMinor = @PROJECT_VERSION_MINOR@;
static const unsigned char kVersionPatch = @PROJECT_VERSION_PATCH@;

unsigned char dinorunner_getversion(struct version_s* version) {
  version->major = kVersionMajor;
  version->minor = kVersionMinor;
  version->patch = kVersionPatch;
  return 1u;
}
